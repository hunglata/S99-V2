{
  "name": "client-snake",
  "version": "1.0.1",
  "description": "game with safex",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "sync-res": "bun ./node_modules/safex-sync-res/src/index.ts",
    "predev": "bun --cwd packages/js-sdl run compile && bun run sync-res",
    "dev": "vite --host",
    "build": "vite build --base /play/SnakesLadders/",
    "postbuild": "rm -rf SnakesLadders && mv dist SnakesLadders",
    "fix": "eslint ./src --fix"
  },
  "keywords": [],
  "author": "safex",
  "license": "ISC",
  "dependencies": {
    "@amoutonbrady/lz-string": "^0.1.0",
    "@colyseus/clock": "^2.0.3",
    "@colyseus/schema": "^4.0.27",
    "@colyseus/timer": "^2.0.3",
    "@safe-engine/sdl": "workspace:*",
    "colyseus.js": "^0.16.22",
    "lodash-es": "^4.18.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/lodash-es": "^4.17.12",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "jiti": "^2.7.0",
    "magic-string": "^0.30.21",
    "safex-sync-res": "^1.4.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.4",
    "vite-plugin-safex-transform": "^1.1.2"
  }
}
